{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenon.coffee/schema/menu.schema.json",
  "title": "Menu product",
  "description": "What the customer sees and orders. Points at a build and limits which formats and slot options are offered.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "code", "name", "version", "build", "status", "formats"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "code": { "type": "string", "pattern": "^MNU-\\d{3}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "description": { "type": "string" },
    "build": { "type": "string", "pattern": "^build/[a-z0-9]+(-[a-z0-9]+)*$" },
    "status": { "enum": ["planned", "available", "retired"] },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/format" }
    },
    "options": {
      "description": "Per slot, the subset of the build's options offered on the menu. Omitted slots offer all options.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "common.schema.json#/$defs/componentRef" }
      }
    },
    "price_sgd": {
      "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }]
    }
  }
}
